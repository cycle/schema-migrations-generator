{
    "$schema": "vendor-bin/infection/vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ]
    },
    "timeout": 10,
    "minMsi": 98,
    "minCoveredMsi": 98,
    "testFramework": "testo",
    "tmpDir": "runtime",
    "mutators": {
        "@default": true,
        "Concat": {
            "ignore": ["Cycle\\Schema\\Generator\\Migrations\\MigrationImage::setDatabase"]
        },
        "ConcatOperandRemoval": {
            "ignore": ["Cycle\\Schema\\Generator\\Migrations\\MigrationImage::setDatabase"]
        },
        "FalseValue": {
            "ignore": ["Cycle\\Schema\\Generator\\Migrations\\MigrationImage::setDatabase"]
        }
    },
    "logs": {
        "stryker": {
            "report": "2.x"
        }
    }
}
